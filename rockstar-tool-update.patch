diff --git a/docs/rockstar-tool/rockstar-compact-preview.html b/docs/rockstar-tool/rockstar-compact-preview.html
new file mode 100644
index 0000000..ebef7c5
--- /dev/null
+++ b/docs/rockstar-tool/rockstar-compact-preview.html
@@ -0,0 +1,6 @@
+<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rockstar Tool compact UI — illustrative preview</title><style>
+@font-face{font-family:Menu;src:url(data:font/ttf;base64,)}@font-face{font-family:Icons;src:url(data:font/otf;base64,)}
+
+*{box-sizing:border-box}body{margin:0;padding:24px;background:#111115;color:#f0f0f0;font:17px/1.35 Menu,Arial,sans-serif}.menu{position:relative;isolation:isolate;width:720px;height:560px;max-width:100%;border:1px solid #b02d32;border-radius:5px;background:linear-gradient(#141417,#461919);overflow:hidden;padding:8px}.bg{position:absolute;z-index:-2;inset:0;width:100%;height:100%;object-fit:cover;opacity:.35}.shade{position:absolute;z-index:-1;inset:0;background:rgba(0,0,0,.1)}.header{height:40px;display:flex;gap:8px;align-items:flex-start;border-bottom:1px solid #b02d32}.brand{font-weight:bold;font-size:22px;line-height:30px;flex:1;white-space:nowrap;padding-left:12px}.header input{width:130px;height:30px;border:0;border-radius:5px;padding:4px 6px;background:#090909d0;color:inherit;font:14px Menu,Arial,sans-serif;min-width:0}.icon{font-family:Icons}.action{width:28px;height:28px;display:grid;place-items:center;background:#40181bd0;border-radius:5px;font-size:18px;flex:none}.layout{display:grid;grid-template-columns:44px minmax(0,1fr);gap:8px;height:calc(100% - 45px);padding-top:6px}.rail{display:flex;flex-direction:column;gap:5px;border-right:1px solid #b02d32}.rail span{width:38px;height:44px;display:grid;place-items:center;font-size:24px;border-radius:5px}.rail .active{background:#76252bd0}.content{display:flex;flex-direction:column;overflow:hidden;min-width:0}.tabs{display:flex;gap:4px;overflow:auto;padding-bottom:7px;border-bottom:1px solid #b02d32;flex:none}.tabs span{padding:4px 7px;background:#160808c9;white-space:nowrap;border-radius:4px;font-size:15px}.tabs .active{background:#76252bd0}.favorites{display:flex;gap:6px;padding:6px 0;flex:none;font-size:14px}.favorites span{background:#381516cc;border-radius:4px;padding:2px 6px}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;overflow:auto;min-height:0;align-items:start}.column{display:flex;flex-direction:column;gap:8px;min-width:0}.card{background:rgba(0,0,0,.78);border:1px solid #b02d32;border-radius:5px;padding:8px;min-width:0}.card h2{font-size:19px;font-weight:bold;color:#dc2d2d;text-align:center;border-bottom:1px solid #b02d32;padding-bottom:5px;margin:0 0 8px}.button{padding:6px 7px;background:#171717;border-radius:5px;margin:5px 0;font-size:15px;text-align:center;min-height:32px}.button.hover{background:#82262c}.check{display:flex;align-items:center;gap:8px;margin:10px 0;font-size:15px}.box{width:19px;height:19px;display:grid;place-items:center;flex:none;background:#181818;border:1px solid #b02d32;color:#ff4d4d;font-family:Arial;font-weight:bold}.card p{font-size:14px;color:#a6a6a6;margin:8px 0}.note{max-width:720px;font:14px/1.5 Arial,sans-serif;color:#aaaab7;margin:16px 0}.modal{display:none;position:fixed;z-index:5;left:40px;top:40px;width:640px;max-width:calc(100vw - 80px);max-height:calc(100vh - 80px);overflow:auto;background:#181315;border:1px solid #b02d32;border-radius:5px;padding:16px;font:16px/1.5 Arial,sans-serif}.modal h2{margin:0 0 16px}.modal .row{display:flex;gap:12px;align-items:center;margin:12px 0}.modal input[type=range]{width:180px;accent-color:#dc2d2d}.modal button{background:#40181b;color:#f0f0f0;font:inherit;padding:8px 12px;border:1px solid #b02d32;border-radius:4px}.modal p{font-size:14px;color:#aaaab7}.modal.visible{display:block}@media(max-width:650px){body{padding:12px}.menu{height:720px}.brand{font-size:16px;padding-left:0;line-height:28px}.header{gap:4px}.header input{width:83px}.action{width:24px;height:28px;font-size:16px}.layout{grid-template-columns:38px minmax(0,1fr);gap:6px}.rail span{width:32px}.cards{grid-template-columns:1fr}.card{padding:8px}.tabs span{font-size:14px}.modal{left:16px;top:16px;max-width:calc(100vw - 32px);max-height:calc(100vh - 32px)}}
