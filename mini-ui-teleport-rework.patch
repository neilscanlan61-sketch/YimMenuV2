+++ b/docs/rockstar-tool/rework-vehicle-preview.html
@@ -0,0 +1,2 @@
+<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rockstar Mini — illustrative UI preview</title><style>@font-face{font-family:Menu;src:url(data:font/ttf;base64,)}
+@font-face{font-family:Icons;src:url(data:font/otf;base64,)}*{box-sizing:border-box}body{margin:0;padding:24px;background:#111115;color:#f0f0f0;font:15px/1.35 Menu,Arial,sans-serif}.menu{position:relative;isolation:isolate;width:640px;height:500px;max-width:100%;overflow:hidden;border:1px solid #9d393d;border-radius:8px;padding:8px;background:#171419}.bg{position:absolute;z-index:-3;inset:0;width:100%;height:100%;object-fit:cover;opacity:.25}.lights{position:absolute;inset:8px;z-index:-2;background:radial-gradient(circle at 18% 80%,#a22b4140,transparent 40%),radial-gradient(circle at 82% 26%,#df3a4230,transparent 35%);pointer-events:none}.header{height:40px;display:flex;gap:6px;border-bottom:1px solid #8e3339;align-items:flex-start}.brand{font-size:20px;font-weight:bold;flex:1;padding:2px 8px;white-space:nowrap}.header input{width:130px;min-width:0;height:27px;border:1px solid #643036;border-radius:7px;background:#121013;color:inherit;padding:4px;font:14px Menu,Arial}.icon{font-family:Icons}.action{width:28px;height:28px;border:1px solid #804148;border-radius:8px;background:#421c2380;color:inherit;font:18px Icons;cursor:pointer}.layout{height:calc(100% - 40px);display:grid;grid-template-columns:44px minmax(0,1fr);gap:8px;padding-top:5px}.rail{display:flex;flex-direction:column;gap:4px;border-right:1px solid #703039}.rail button{font:22px Icons;color:inherit;background:none;border:0;border-radius:8px;width:38px;height:36px;flex:none}.rail .active{background:#762d3750}.content{min-width:0;display:flex;flex-direction:column}.tabs{display:flex;gap:4px;overflow:auto;min-height:35px;padding-bottom:6px}.tabs button,.favorite,button.option{font:inherit;color:inherit;border:1px solid #713038;border-radius:8px;background:#291820;padding:4px 8px;white-space:nowrap}.tabs .active{background:#86373f}.favorites{display:flex;gap:5px;padding-bottom:6px;font-size:14px}.favorite{padding:2px 7px;background:#341b22}.cards{overflow:auto;flex:1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;align-items:start}.column{display:grid;gap:8px;min-width:0}.card{background:#050507c7;border:1px solid #87353b;border-radius:8px;padding:8px;min-width:0}.card h2{font-size:17px;color:#df454b;margin:0 0 7px;text-align:center;border-bottom:1px solid #6b2c35;padding-bottom:5px}.option{width:100%;margin:4px 0;background:#1d1b20!important;white-space:normal!important;min-height:28px;text-align:center;font-size:14px!important}.option.selected{background:#68313b!important}.check{display:flex;gap:7px;align-items:center;margin:7px 0;font-size:14px}.box{width:18px;height:18px;flex:none;border:1px solid #a54852;border-radius:6px;background:#252029;color:#ff7378;display:grid;place-items:center;font:bold 13px Arial}.card p{color:#aaa5ae;font-size:14px;margin:8px 0}.note{max-width:640px;font:14px/1.5 Arial;color:#aaa7b4;margin:15px 0}.modal{display:none;position:absolute;z-index:4;inset:58px 80px 44px;background:#19151b;border:1px solid #9c4650;border-radius:10px;padding:14px;overflow:auto;box-shadow:0 15px 50px #0008}.modal h2{font-size:19px;margin:0 0 10px}.modal label{display:block;font-size:14px;margin:9px 0 4px}.field{width:100%;padding:6px 8px;border:1px solid #9c4650;border-radius:8px;background:#100e12;color:inherit;font:14px Menu}.modal p{color:#b4a8b8;font-size:14px}.modal button{font:14px Menu;color:inherit;background:#31232b;border:1px solid #97505a;border-radius:8px;padding:6px 9px;margin:4px 0}.modal.visible{display:block}@media(max-width:680px){body{padding:12px}.menu{height:600px}.brand{font-size:14px;padding:4px 0}.header{gap:4px}.header input{width:80px;font-size:12px}.action{width:24px;flex:none}.layout{grid-template-columns:38px minmax(0,1fr);gap:5px}.rail button{width:32px}.tabs button{font-size:13px;padding:4px 5px}.cards{grid-template-columns:1fr}.modal{inset:55px 12px 24px}.note{font-size:14px}}@media(prefers-reduced-motion:reduce){.bg{display:none}}</style></head><body><main class="menu"><img class="bg" src="data:image/gif;base64," alt="Supplied red GIF background"><div class="lights"></div><header class="header"><span class="brand">ROCKSTAR TOOL</span><input placeholder="Search sections" aria-label="Search"><button class="action" aria-label="Themes" onclick="document.getElementById('modal').classList.add('visible')">&#xf1fc;</button><button class="action" aria-label="Favorites">&#xf005;</button></header><div class="layout"><nav class="rail" aria-label="Sections"><button class="icon ">&#xf007;</button><button class="icon ">&#xf0c0;</button><button class="icon ">&#xf0e8;</button><button class="icon ">&#xf0ac;</button><button class="icon active">&#xf1b9;</button><button class="icon ">&#xf0ac;</button><button class="icon ">&#xf013;</button><button class="icon ">&#xf120;</button></nav><section class="content"><div class="tabs"><button class="active">Main</button><button class="">Spawn Vehicle</button><button class="">Vehicle Editor</button><button class="">Saved Vehicles</button></div><div class="favorites"><span class="favorite">+ Save</span><span class="favorite">Favorites</span></div><div class="cards"><div class="column"><section class="card"><h2>Tools</h2><button class="option">Enter Last Vehicle</button><button class="option">Repair Vehicle</button><button class="option">Call Mechanic</button><button class="option">Request Personal Vehicle</button><button class="option selected">Convert Current Vehicle to PV</button><p>Uses the existing savepersonalvehicle command and its original checks.</p></section></div><div class="column"><section class="card"><h2>Globals</h2><div class="check"><span class="box">✓</span>Godmode</div><div class="check"><span class="box">✓</span>Keep Fixed</div><div class="check"><span class="box"></span>Horn Boost</div></section><section class="card"><h2>Misc</h2><div class="check"><span class="box">✓</span>Savage Entry Camera Guard</div><div class="check"><span class="box"></span>Speedometer</div><div class="check"><span class="box"></span>Seatbelt</div><p>Existing camera workaround retained.</p></section></div></div></section></div><section class="modal" id="modal"><h2>Themes</h2><button onclick="document.getElementById('modal').classList.remove('visible')">Close</button><label>Theme</label><select class="field"><option>Rockstar Mini</option><option>Rojo Mini</option></select><label>Custom theme name</label><input class="field" value="Rojo Mini"><button>Load custom theme</button><br><button>Refresh themes / GIF</button><div class="check"><span class="box">✓</span>Animated GIF background</div><p>Place My Theme.theme and My Theme.gif in the click-ui theme folder. Advanced colors and dimensions stay in the file.</p></section></main><p class="note">Illustrative preview, not a compiled DLL screenshot. 640 × 500 preset with supplied GIF, soft lighting and rounded controls. No game actions execute here; saved places are synthetic examples. Windows build and in-game testing required. Not affiliated with Rockstar Games or Cherax.</p></body></html>
