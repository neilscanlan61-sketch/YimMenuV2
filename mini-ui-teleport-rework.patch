+            const float width=std::max(1.0f,(ImGui::GetContentRegionAvail().x-ImGui::GetStyle().ItemSpacing.x)*0.5f);
+            if (ImGui::Button("Teleport",ImVec2(width,0))) QueueSavedTeleport(*selected);
